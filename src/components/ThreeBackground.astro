<div id="synthscape" class="synthscape" aria-hidden="true" transition:persist="synthscape">
  <div class="synthscape__aurora synthscape__aurora--cyan"></div>
  <div class="synthscape__aurora synthscape__aurora--pink"></div>
  <div class="synthscape__stars synthscape__stars--far"></div>
  <div class="synthscape__stars synthscape__stars--near"></div>
  <div class="synthscape__sun"><span></span></div>
  <div class="synthscape__horizon"></div>
  <div class="synthscape__grid"></div>
  <div class="synthscape__beam"></div>
  <div class="synthscape__vignette"></div>
</div>

<style>
  .synthscape {
    --pointer-x: 0;
    --pointer-y: 0;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background:
      radial-gradient(circle at 50% 52%, rgba(103, 28, 158, 0.2), transparent 28%),
      linear-gradient(180deg, #070815 0%, #0b0922 50%, #12082a 64%, #050711 100%);
    isolation: isolate;
  }

  .synthscape__aurora {
    position: absolute;
    width: 62vw;
    height: 62vw;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.16;
    transform: translate3d(calc(var(--pointer-x) * 20px), calc(var(--pointer-y) * 14px), 0);
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
    animation: aurora-breathe 9s ease-in-out infinite alternate;
  }

  .synthscape__aurora--cyan {
    left: -28vw;
    top: -24vw;
    background: #00e7ff;
  }

  .synthscape__aurora--pink {
    right: -30vw;
    top: 5vh;
    background: #ff3dbf;
    animation-delay: -4.5s;
  }

  .synthscape__stars {
    position: absolute;
    inset: -10%;
    transform: translate3d(calc(var(--pointer-x) * -9px), calc(var(--pointer-y) * -6px), 0);
    background-image:
      radial-gradient(circle at 8% 16%, rgba(255, 255, 255, 0.9) 0 1px, transparent 1.5px),
      radial-gradient(circle at 22% 42%, rgba(104, 238, 255, 0.85) 0 1px, transparent 1.7px),
      radial-gradient(circle at 48% 13%, rgba(255, 101, 208, 0.8) 0 1px, transparent 1.6px),
      radial-gradient(circle at 72% 35%, rgba(255, 255, 255, 0.85) 0 1px, transparent 1.5px),
      radial-gradient(circle at 91% 19%, rgba(255, 228, 113, 0.85) 0 1px, transparent 1.7px);
    background-size: 420px 330px;
    opacity: 0.5;
    transition: transform 900ms cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .synthscape__stars--near {
    inset: -14%;
    transform: translate3d(calc(var(--pointer-x) * -18px), calc(var(--pointer-y) * -12px), 0);
    background-size: 690px 510px;
    background-position: 113px 71px;
    opacity: 0.35;
    filter: drop-shadow(0 0 4px rgba(0, 231, 255, 0.65));
  }

  .synthscape__sun {
    position: absolute;
    left: 50%;
    top: 46%;
    width: clamp(13rem, 27vw, 28rem);
    aspect-ratio: 1;
    transform: translate3d(calc(-50% + var(--pointer-x) * 10px), calc(-50% + var(--pointer-y) * 5px), 0);
    border-radius: 50%;
    overflow: hidden;
    background: linear-gradient(180deg, #fff4a1 0%, #ff9f45 38%, #ff3dab 77%, #d827ff 100%);
    box-shadow:
      0 0 30px rgba(255, 80, 185, 0.38),
      0 0 100px rgba(255, 48, 180, 0.2),
      0 0 200px rgba(128, 42, 255, 0.16);
    opacity: 0.58;
    transition: transform 700ms cubic-bezier(0.2, 0.8, 0.2, 1);
    mask-image: linear-gradient(to bottom, black 0 62%, transparent 94%);
  }

  .synthscape__sun::after {
    content: "";
    position: absolute;
    inset: 40% 0 0;
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 8px,
      #080817 9px 13px
    );
  }

  .synthscape__sun span {
    position: absolute;
    inset: 8%;
    border: 1px solid rgba(255, 255, 255, 0.22);
    border-radius: 50%;
  }

  .synthscape__horizon {
    position: absolute;
    inset: 61% 0 auto;
    height: 2px;
    background: linear-gradient(90deg, transparent, #00e7ff 18%, #ff3dbf 50%, #ffe46f 82%, transparent);
    box-shadow:
      0 0 14px rgba(0, 231, 255, 0.75),
      0 0 28px rgba(255, 61, 191, 0.55);
    opacity: 0.7;
  }

  .synthscape__grid {
    position: absolute;
    left: -55%;
    right: -55%;
    top: 61%;
    height: 72%;
    transform-origin: 50% 0;
    transform: perspective(420px) rotateX(63deg) translateY(-2px);
    background-image:
      linear-gradient(rgba(0, 231, 255, 0.24) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 61, 191, 0.23) 1px, transparent 1px);
    background-size: 70px 46px;
    mask-image: linear-gradient(to bottom, rgba(0, 0, 0, 0.92), transparent 88%);
    animation: grid-drive 2.8s linear infinite;
  }

  .synthscape__beam {
    position: absolute;
    left: 50%;
    top: 61%;
    width: min(56rem, 78vw);
    height: 46vh;
    transform: translateX(-50%);
    clip-path: polygon(47% 0, 53% 0, 100% 100%, 0 100%);
    background: linear-gradient(90deg, transparent, rgba(255, 61, 191, 0.08), rgba(0, 231, 255, 0.1), transparent);
    filter: blur(2px);
  }

  .synthscape__vignette {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, rgba(5, 7, 17, 0.06), transparent 52%, rgba(5, 7, 17, 0.74)),
      radial-gradient(ellipse at center, transparent 34%, rgba(4, 5, 14, 0.64) 100%);
  }

  @keyframes grid-drive {
    to { background-position: 0 46px, 0 0; }
  }

  @keyframes aurora-breathe {
    from { opacity: 0.11; scale: 0.92; }
    to { opacity: 0.2; scale: 1.08; }
  }

  @media (max-width: 640px) {
    .synthscape__sun { top: 48%; width: 13rem; opacity: 0.34; }
    .synthscape__horizon,
    .synthscape__grid,
    .synthscape__beam { top: 59%; }
    .synthscape__grid { background-size: 54px 38px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .synthscape__aurora,
    .synthscape__grid { animation: none; }
  }
</style>

<script>
  interface SynthscapeState {
    initialized: boolean;
    scene?: HTMLElement;
  }

  declare global {
    interface Window {
      __shadowNineSynthscape?: SynthscapeState;
    }
  }

  const setupSynthscape = () => {
    const scene = document.getElementById("synthscape") as HTMLElement | null;
    if (!scene) return;

    const state = (window.__shadowNineSynthscape ??= { initialized: false });
    state.scene = scene;
    if (state.initialized) return;

    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    window.addEventListener(
      "pointermove",
      (event) => {
        if (!finePointer.matches || !state.scene) return;
        const x = event.clientX / Math.max(window.innerWidth, 1) - 0.5;
        const y = event.clientY / Math.max(window.innerHeight, 1) - 0.5;
        state.scene.style.setProperty("--pointer-x", x.toFixed(3));
        state.scene.style.setProperty("--pointer-y", y.toFixed(3));
      },
      { passive: true },
    );

    state.initialized = true;
  };

  setupSynthscape();
  document.addEventListener("astro:page-load", setupSynthscape);
</script>
