<div class="sky-map" aria-hidden="true" transition:persist="sky-map">
  <div class="sky-map__glow sky-map__glow--sun"></div>
  <div class="sky-map__glow sky-map__glow--cyan"></div>
  <svg class="sky-map__orbits" viewBox="0 0 1200 800" preserveAspectRatio="xMidYMid slice">
    <g fill="none" stroke="currentColor">
      <ellipse cx="860" cy="235" rx="360" ry="118" transform="rotate(-14 860 235)" />
      <ellipse cx="210" cy="610" rx="285" ry="90" transform="rotate(17 210 610)" />
      <path d="M-80 438C195 285 420 326 650 466s434 144 650-20" />
    </g>
    <g class="sky-map__nodes">
      <circle cx="562" cy="169" r="4" />
      <circle cx="977" cy="122" r="3" />
      <circle cx="1116" cy="264" r="5" />
      <circle cx="82" cy="550" r="4" />
      <circle cx="396" cy="687" r="3" />
      <circle cx="716" cy="500" r="4" />
    </g>
  </svg>
  <div class="sky-map__stars"></div>
</div>

<div class="afterglow-geometry" aria-hidden="true" transition:persist="afterglow-geometry">
  <span class="afterglow-arch afterglow-arch--teal"></span>
  <span class="afterglow-arch afterglow-arch--apricot"></span>
  <span class="afterglow-sun"></span>
  <svg class="afterglow-horizon" viewBox="0 0 1440 460" preserveAspectRatio="none" fill="none">
    <path d="M-100 300C230 65 400 475 775 250S1250 45 1540 170" />
    <path d="M-100 318C230 83 400 493 775 268S1250 63 1540 188" />
  </svg>
</div>

<style>
  .afterglow-geometry { display: none; }

  :global([data-theme="gta6"]) .afterglow-geometry {
    position: fixed;
    inset: 0;
    z-index: 0;
    display: block;
    overflow: hidden;
    pointer-events: none;
  }

  .afterglow-arch {
    position: absolute;
    width: clamp(13rem, 21vw, 23rem);
    height: clamp(27rem, 65vh, 44rem);
    border: 1px solid currentColor;
    border-radius: 50% 50% 0 0;
  }

  .afterglow-arch::after {
    position: absolute;
    inset: 0.85rem;
    border: 1px solid currentColor;
    border-bottom: 0;
    border-radius: inherit;
    content: "";
  }

  .afterglow-arch--teal {
    top: 18vh;
    left: -9rem;
    color: color-mix(in srgb, var(--cyan) 22%, transparent);
    transform: rotate(-18deg);
  }

  .afterglow-arch--apricot {
    right: -8rem;
    bottom: -12rem;
    color: color-mix(in srgb, var(--coral) 20%, transparent);
    transform: rotate(24deg);
  }

  .afterglow-sun {
    position: absolute;
    top: 17vh;
    right: 3vw;
    width: clamp(7rem, 12vw, 12rem);
    aspect-ratio: 1;
    border: 1px solid color-mix(in srgb, var(--solar) 18%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--coral) 4%, transparent);
  }

  .afterglow-horizon {
    position: absolute;
    inset: auto 0 -4rem;
    width: 100%;
    height: 46vh;
    stroke: color-mix(in srgb, var(--magenta) 13%, transparent);
    stroke-width: 1;
  }

  @media (max-width: 680px) {
    .afterglow-arch--teal { left: -10rem; opacity: 0.7; }
    .afterglow-arch--apricot { right: -11rem; }
    .afterglow-sun { top: 24vh; right: -3rem; opacity: 0.6; }
    .afterglow-horizon { opacity: 0.6; }
  }

  .sky-map {
    --drift-x: 0px;
    --drift-y: 0px;
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
  }

  .sky-map__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(2px);
    opacity: 0.7;
  }

  .sky-map__glow--sun {
    top: 7rem;
    right: -8rem;
    width: 25rem;
    height: 25rem;
    background: radial-gradient(circle, rgb(255 209 102 / 0.22), rgb(255 143 112 / 0.07) 48%, transparent 72%);
    transform: translate(var(--drift-x), var(--drift-y));
  }

  .sky-map__glow--cyan {
    bottom: -12rem;
    left: -9rem;
    width: 32rem;
    height: 32rem;
    background: radial-gradient(circle, rgb(113 231 236 / 0.14), transparent 68%);
    transform: translate(calc(var(--drift-x) * -0.6), calc(var(--drift-y) * -0.6));
  }

  .sky-map__orbits {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgb(167 139 250 / 0.11);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
    transform: translate(calc(var(--drift-x) * 0.35), calc(var(--drift-y) * 0.35));
  }

  .sky-map__nodes {
    fill: #ffd166;
    stroke: none;
    filter: drop-shadow(0 0 7px rgb(255 209 102 / 0.55));
  }

  .sky-map__stars {
    position: absolute;
    inset: 0;
    opacity: 0.3;
    background-image:
      radial-gradient(circle at 12% 19%, #fffaf0 0 1px, transparent 1.5px),
      radial-gradient(circle at 68% 14%, #71e7ec 0 1px, transparent 1.5px),
      radial-gradient(circle at 34% 71%, #ffd166 0 1px, transparent 1.5px),
      radial-gradient(circle at 88% 78%, #f083c8 0 1px, transparent 1.5px);
    background-size: 250px 250px, 340px 340px, 410px 410px, 520px 520px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .sky-map__nodes circle {
      animation: signal-pulse 5s ease-in-out infinite;
    }

    .sky-map__nodes circle:nth-child(2n) {
      animation-delay: -2.5s;
    }
  }

  @keyframes signal-pulse {
    50% {
      opacity: 0.35;
    }
  }
</style>

<script>
  const setupSkyMap = () => {
    const map = document.querySelector<HTMLElement>(".sky-map");
    if (!map || map.dataset.ready === "true") return;

    const finePointer = window.matchMedia("(hover: hover) and (pointer: fine)");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    window.addEventListener(
      "pointermove",
      (event) => {
        if (!finePointer.matches || reducedMotion.matches) return;
        const x = (event.clientX / Math.max(window.innerWidth, 1) - 0.5) * 12;
        const y = (event.clientY / Math.max(window.innerHeight, 1) - 0.5) * 10;
        map.style.setProperty("--drift-x", `${x.toFixed(1)}px`);
        map.style.setProperty("--drift-y", `${y.toFixed(1)}px`);
      },
      { passive: true },
    );
    map.dataset.ready = "true";
  };

  setupSkyMap();
  document.addEventListener("astro:page-load", setupSkyMap);
</script>
