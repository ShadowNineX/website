<canvas
  id="three-bg"
  transition:persist="three-background"
  class="pointer-events-none fixed inset-0 -z-10 h-screen w-screen opacity-90"></canvas>

<script>
  import * as THREE from "three";

  const canvas = document.getElementById("three-bg") as HTMLCanvasElement;
  const prefersReducedMotion = window.matchMedia(
    "(prefers-reduced-motion: reduce)",
  );

  const viewportSize = () => ({
    width: Math.max(window.innerWidth, 1),
    height: Math.max(window.innerHeight, 1),
  });
  const initialViewport = viewportSize();

  const scene = new THREE.Scene();
  const camera = new THREE.PerspectiveCamera(
    56,
    initialViewport.width / initialViewport.height,
    0.1,
    100,
  );
  camera.position.set(0, 0, 10.4);

  const renderer = new THREE.WebGLRenderer({
    canvas,
    antialias: true,
    alpha: true,
  });
  renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
  renderer.setSize(initialViewport.width, initialViewport.height, false);
  renderer.setClearColor(0xfff7df, 0);

  scene.add(new THREE.AmbientLight(0xfff4cf, 1.45));

  const sun = new THREE.DirectionalLight(0xffffff, 1.4);
  sun.position.set(5, 6, 7);
  scene.add(sun);

  const skyLight = new THREE.PointLight(0x5bb7f0, 1.6, 28);
  skyLight.position.set(-5, 3, 5);
  scene.add(skyLight);

  const honeyLight = new THREE.PointLight(0xffb23f, 1.8, 24);
  honeyLight.position.set(5, -2.4, 4);
  scene.add(honeyLight);

  const world = new THREE.Group();
  scene.add(world);

  const railMaterials = {
    warm: new THREE.MeshBasicMaterial({
      color: 0xffd36b,
      transparent: true,
      opacity: 0.34,
      depthWrite: false,
    }),
    warmGlow: new THREE.MeshBasicMaterial({
      color: 0xffa62b,
      transparent: true,
      opacity: 0.08,
      depthWrite: false,
    }),
    sky: new THREE.MeshBasicMaterial({
      color: 0x7dd3fc,
      transparent: true,
      opacity: 0.26,
      depthWrite: false,
    }),
    skyGlow: new THREE.MeshBasicMaterial({
      color: 0x38bdf8,
      transparent: true,
      opacity: 0.07,
      depthWrite: false,
    }),
  };

  const createBadgeTexture = () => {
    const size = 512;
    const textureCanvas = document.createElement("canvas");
    textureCanvas.width = size;
    textureCanvas.height = size;

    const context = textureCanvas.getContext("2d");
    if (!context) return null;

    const gradient = context.createLinearGradient(0, 0, size, size);
    gradient.addColorStop(0, "#fff1ad");
    gradient.addColorStop(0.52, "#ffbf58");
    gradient.addColorStop(1, "#65b7e8");
    context.fillStyle = gradient;
    context.fillRect(0, 0, size, size);

    context.fillStyle = "rgba(255, 255, 255, 0.58)";
    context.beginPath();
    context.ellipse(254, 262, 168, 118, -0.56, 0, Math.PI * 2);
    context.fill();
    context.beginPath();
    context.ellipse(300, 272, 168, 118, 0.56, 0, Math.PI * 2);
    context.fill();

    context.strokeStyle = "rgba(126, 75, 23, 0.42)";
    context.lineWidth = 16;
    context.beginPath();
    context.moveTo(122, 322);
    context.quadraticCurveTo(236, 198, 386, 176);
    context.stroke();
    context.beginPath();
    context.moveTo(388, 322);
    context.quadraticCurveTo(280, 200, 126, 176);
    context.stroke();

    context.fillStyle = "#3f2618";
    context.font =
      "700 58px system-ui, -apple-system, BlinkMacSystemFont, Segoe UI, sans-serif";
    context.textAlign = "center";
    context.textBaseline = "middle";
    context.fillText("ShadowNine", 256, 104);

    const texture = new THREE.CanvasTexture(textureCanvas);
    texture.colorSpace = THREE.SRGBColorSpace;
    texture.anisotropy = 4;
    return texture;
  };

  const badge = new THREE.Mesh(
    new THREE.CylinderGeometry(1.35, 1.35, 0.16, 96),
    [
      new THREE.MeshStandardMaterial({
        color: 0xf7a943,
        roughness: 0.38,
        metalness: 0.08,
      }),
      new THREE.MeshStandardMaterial({
        map: createBadgeTexture(),
        roughness: 0.3,
        metalness: 0.04,
      }),
      new THREE.MeshStandardMaterial({
        map: createBadgeTexture(),
        roughness: 0.3,
        metalness: 0.04,
      }),
    ],
  );
  badge.position.set(2.75, 2.1, -4.35);
  badge.rotation.set(0.28, -0.34, 0.08);
  world.add(badge);

  const floaters: Array<{
    object: THREE.Object3D;
    spin: THREE.Vector3;
    drift: number;
    originY: number;
  }> = [];

  const addFloater = (
    object: THREE.Object3D,
    position: THREE.Vector3,
    scale: number,
    spin: THREE.Vector3,
    drift: number,
  ) => {
    object.position.copy(position);
    object.scale.setScalar(scale);
    world.add(object);
    floaters.push({ object, spin, drift, originY: position.y });
  };

  const materials = {
    honey: new THREE.MeshStandardMaterial({
      color: 0xffb84d,
      roughness: 0.42,
      metalness: 0.1,
      transparent: true,
      opacity: 0.72,
    }),
    sky: new THREE.MeshStandardMaterial({
      color: 0x75c7ef,
      roughness: 0.4,
      metalness: 0.08,
      transparent: true,
      opacity: 0.64,
      wireframe: true,
    }),
    cream: new THREE.MeshStandardMaterial({
      color: 0xfff4d6,
      roughness: 0.55,
      metalness: 0.04,
    }),
  };

  addFloater(
    new THREE.Mesh(new THREE.TorusGeometry(1.12, 0.055, 12, 96), materials.honey),
    new THREE.Vector3(-4.55, 2.2, -5.7),
    1,
    new THREE.Vector3(0.001, 0.0018, 0.0007),
    0.6,
  );
  addFloater(
    new THREE.Mesh(new THREE.IcosahedronGeometry(1.25, 1), materials.sky),
    new THREE.Vector3(4.25, -2.7, -6.05),
    0.86,
    new THREE.Vector3(-0.0014, 0.001, 0.0017),
    0.72,
  );
  addFloater(
    new THREE.Mesh(new THREE.BoxGeometry(1.55, 1.55, 1.55), materials.cream),
    new THREE.Vector3(-2.2, -3.25, -6.55),
    0.6,
    new THREE.Vector3(0.0012, -0.001, 0.0015),
    0.42,
  );

  const rails = new THREE.Group();
  const railNodes: Array<{
    object: THREE.Mesh;
    originX: number;
    speed: number;
  }> = [];

  for (let i = 0; i < 10; i++) {
    const y = -5.4 + i * 1.16;
    const z = -7.4 - i * 0.24;
    const curve = new THREE.CatmullRomCurve3([
      new THREE.Vector3(-30, y - 0.2, z - 0.8),
      new THREE.Vector3(-14, y + Math.sin(i * 0.8) * 0.82, z - 0.45),
      new THREE.Vector3(0, y - Math.cos(i * 0.9) * 0.72, z),
      new THREE.Vector3(14, y + Math.sin(i * 1.2) * 0.7, z - 0.35),
      new THREE.Vector3(30, y + Math.cos(i * 0.7) * 0.58, z - 0.8),
    ]);
    const points = curve.getPoints(180);
    const lineMaterial = i % 2 ? railMaterials.sky : railMaterials.warm;
    const glowMaterial = i % 2 ? railMaterials.skyGlow : railMaterials.warmGlow;

    rails.add(
      new THREE.Mesh(
        new THREE.TubeGeometry(curve, 180, 0.018, 8, false),
        lineMaterial,
      ),
    );
    rails.add(
      new THREE.Mesh(
        new THREE.TubeGeometry(curve, 180, 0.064, 10, false),
        glowMaterial,
      ),
    );

    if (i % 2 === 0) {
      const point = points[Math.floor(points.length * 0.58)];
      const node = new THREE.Mesh(
        new THREE.SphereGeometry(0.075, 16, 16),
        new THREE.MeshBasicMaterial({
          color: 0xfff1ad,
          transparent: true,
          opacity: 0.7,
          depthWrite: false,
        }),
      );
      node.position.copy(point);
      rails.add(node);
      railNodes.push({
        object: node,
        originX: node.position.x,
        speed: 0.18 + i * 0.018,
      });
    }
  }
  scene.add(rails);

  const mouse = new THREE.Vector2(0, 0);

  const onPointerMove = (event: PointerEvent) => {
    mouse.x = (event.clientX / window.innerWidth - 0.5) * 2;
    mouse.y = (event.clientY / window.innerHeight - 0.5) * 2;
  };

  const onResize = () => {
    const { width, height } = viewportSize();
    const aspect = width / height;

    camera.aspect = aspect;
    camera.fov = aspect < 0.85 ? 64 : 56;
    camera.position.z = aspect < 0.85 ? 11.6 : 10.4;
    camera.updateProjectionMatrix();

    rails.scale.x = aspect < 0.85 ? 1.42 : Math.max(1.12, aspect / 1.08);
    rails.scale.y = aspect < 0.85 ? 1.22 : 1.04;

    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.setSize(width, height, false);
  };

  onResize();

  window.addEventListener("pointermove", onPointerMove, { passive: true });
  window.addEventListener("resize", onResize);
  document.addEventListener("astro:after-swap", onResize);
  document.addEventListener("astro:page-load", onResize);

  const startedAt = performance.now();
  (function animate() {
    requestAnimationFrame(animate);
    const elapsed = (performance.now() - startedAt) / 1000;
    const motionScale = prefersReducedMotion.matches ? 0.22 : 1;

    world.rotation.x +=
      (mouse.y * 0.055 - world.rotation.x) * 0.018 * motionScale;
    world.rotation.y +=
      (mouse.x * 0.08 - world.rotation.y) * 0.018 * motionScale;
    rails.rotation.z = Math.sin(elapsed * 0.08) * 0.018;

    badge.rotation.z = Math.sin(elapsed * 0.42) * 0.05;
    for (const floater of floaters) {
      floater.object.rotation.x += floater.spin.x * motionScale;
      floater.object.rotation.y += floater.spin.y * motionScale;
      floater.object.rotation.z += floater.spin.z * motionScale;
      floater.object.position.y =
        floater.originY + Math.sin(elapsed * floater.drift) * 0.12;
    }
    for (const node of railNodes) {
      node.object.position.x =
        node.originX + Math.sin(elapsed * node.speed) * 0.46;
      node.object.scale.setScalar(1 + Math.sin(elapsed * node.speed * 2.2) * 0.18);
    }


    honeyLight.position.x = Math.sin(elapsed * 0.28) * 4.5;
    skyLight.position.y = 2.5 + Math.cos(elapsed * 0.22) * 1.4;
    renderer.render(scene, camera);
  })();
</script>
