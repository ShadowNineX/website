---
import { Icon } from "astro-iconify";
import { execSync } from "node:child_process";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fallbackYear = new Date().getFullYear();
const runGit = (command: string) => {
  try {
    return execSync(command, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return "";
  }
};
const commitHash =
  import.meta.env.PUBLIC_GIT_COMMIT?.slice(0, 7) ??
  import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7) ??
  import.meta.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7) ??
  runGit("git rev-parse --short HEAD");
const fullCommitHash =
  import.meta.env.PUBLIC_GIT_COMMIT ??
  import.meta.env.PUBLIC_COMMIT_SHA ??
  import.meta.env.VERCEL_GIT_COMMIT_SHA ??
  runGit("git rev-parse HEAD");
const remoteUrl = runGit("git config --get remote.origin.url")
  .replace(/^git@github\.com:/, "https://github.com/")
  .replace(/\.git$/, "");
const commitUrl =
  remoteUrl && fullCommitHash ? `${remoteUrl}/commit/${fullCommitHash}` : "";
const footerLinks = [
  { href: `${base}/`, label: "Home", icon: "lucide:house" },
  { href: `${base}/blog`, label: "Notes", icon: "lucide:notebook-tabs" },
  { href: `${base}/linktree`, label: "Explore", icon: "lucide:orbit" },
  { href: `${base}/privacy`, label: "Privacy", icon: "lucide:shield-check" },
];
---

<footer class="site-footer">
  <div class="footer-inner wrap">
    <div>
      <div class="footer-signal">
        <span aria-hidden="true">
          <Icon name="lucide:radio-tower" width="17" height="17" />
        </span>
        <div class="footer-copy">
          <strong>The light stays on.</strong>
          <p>&copy; <span data-current-year>{fallbackYear}</span> ShadowNine. Alex's home signal, with Tails nearby at the bench.</p>
        </div>
      </div>
      <p class="footer-meta">
        Astro + Bun
        {commitHash && (
          <>
            <span aria-hidden="true"> / </span>
            {commitUrl ? (
              <a href={commitUrl} target="_blank" rel="noopener noreferrer" aria-label={`View commit ${commitHash} on GitHub`}>
                build {commitHash}
              </a>
            ) : (
              <span>build {commitHash}</span>
            )}
          </>
        )}
      </p>
    </div>

    <nav aria-label="Footer navigation">
      <ul class="footer-nav">
        {footerLinks.map((link) => (
          <li>
            <a href={link.href}>
              <Icon name={link.icon} width="14" height="14" />
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</footer>

<script>
  const currentYear = document.querySelector("[data-current-year]");
  if (currentYear) currentYear.textContent = new Date().getFullYear().toString();
</script>
