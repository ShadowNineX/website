---
import { Icon } from "astro-iconify";
import { execSync } from "node:child_process";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const fallbackYear = new Date().getFullYear();
const siteName = "ShadowNine";

const runGit = (command: string) => {
  try {
    return execSync(command, {
      encoding: "utf8",
      stdio: ["ignore", "pipe", "ignore"],
    }).trim();
  } catch {
    return "";
  }
};

const commitHash =
  import.meta.env.PUBLIC_GIT_COMMIT?.slice(0, 7) ??
  import.meta.env.PUBLIC_COMMIT_SHA?.slice(0, 7) ??
  import.meta.env.VERCEL_GIT_COMMIT_SHA?.slice(0, 7) ??
  runGit("git rev-parse --short HEAD");
const fullCommitHash =
  import.meta.env.PUBLIC_GIT_COMMIT ??
  import.meta.env.PUBLIC_COMMIT_SHA ??
  import.meta.env.VERCEL_GIT_COMMIT_SHA ??
  runGit("git rev-parse HEAD");
const remoteUrl = runGit("git config --get remote.origin.url")
  .replace(/^git@github\.com:/, "https://github.com/")
  .replace(/\.git$/, "");
const commitUrl =
  remoteUrl && fullCommitHash ? `${remoteUrl}/commit/${fullCommitHash}` : "";

const footerLinks = [
  { href: `${base}/`, label: "Decide", icon: "lucide:radar" },
  { href: `${base}/blog`, label: "Learn", icon: "lucide:book-open-text" },
  { href: `${base}/linktree`, label: "Explore", icon: "lucide:compass" },
  { href: `${base}/privacy`, label: "Privacy", icon: "lucide:shield-check" },
];
---

<footer class="section-beam relative z-20 border-t border-border/70 bg-background/82 backdrop-blur-2xl">
  <div
    class="mx-auto grid max-w-7xl gap-7 px-4 py-8 sm:px-6 lg:grid-cols-[1fr_auto] lg:items-center"
  >
    <div class="neon-panel px-4 py-4 sm:px-5">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div class="min-w-0">
          <p class="flex items-center gap-2 text-sm font-black uppercase tracking-[0.18em]">
            <span class="flex size-8 shrink-0 items-center justify-center rounded-md border border-primary/45 bg-primary/12 text-primary shadow-[0_0_22px_rgba(0,229,255,0.18)]">
              <Icon name="lucide:radio-tower" width="16" height="16" />
            </span>
            {siteName}
          </p>
          <p class="mt-3 text-sm leading-6 text-muted-foreground">
            &copy; <span data-current-year>{fallbackYear}</span> {siteName}.
            Tails is nearby, keeping the workshop lights steady.
          </p>
        </div>

        <p class="flex flex-wrap items-center gap-x-3 gap-y-2 text-xs font-bold uppercase tracking-[0.12em] text-muted-foreground">
          <span class="inline-flex items-center gap-1.5">
            <Icon name="lucide:code-2" width="13" height="13" class="text-primary" />
            Astro / Bun / neon experiments
          </span>
          {
            commitHash && (
              <span class="inline-flex items-center gap-1.5">
                <Icon
                  name="lucide:git-commit-horizontal"
                  width="13"
                  height="13"
                  class="text-accent"
                />
                {commitUrl ? (
                  <a
                    href={commitUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="font-mono text-foreground transition-colors hover:text-primary"
                    aria-label={`View commit ${commitHash} on GitHub`}
                  >
                    {commitHash}
                  </a>
                ) : (
                  <span class="font-mono text-foreground">{commitHash}</span>
                )}
              </span>
            )
          }
        </p>
      </div>
    </div>

    <nav aria-label="Footer navigation">
      <ul class="grid grid-cols-2 gap-2 sm:flex sm:flex-wrap lg:justify-end">
        {
          footerLinks.map((link) => (
            <li>
              <a href={link.href} class="ghost-button w-full sm:w-auto">
                <Icon name={link.icon} width="15" height="15" />
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</footer>

<script>
  const currentYear = document.querySelector("[data-current-year]");

  if (currentYear) {
    currentYear.textContent = new Date().getFullYear().toString();
  }
</script>
