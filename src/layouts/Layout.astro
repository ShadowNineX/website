---
import "../styles/global.css";
import Head from "@/components/Head.astro";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-iconify";
import CustomCursor from "@/components/CustomCursor.astro";
import Footer from "@/components/Footer.astro";
import ThreeBackground from "@/components/ThreeBackground.astro";
import { normalizeRoutePath } from "@/lib/routes";
import type { Props as SEOProps } from "astro-seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  openGraph?: SEOProps["openGraph"];
  twitter?: SEOProps["twitter"];
  noindex?: boolean;
  nofollow?: boolean;
  themeColor?: string;
  showChrome?: boolean;
}

const {
  title,
  description,
  canonical,
  openGraph,
  twitter,
  noindex,
  nofollow,
  themeColor,
  showChrome = true,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const pathname = Astro.url.pathname;
const navLinks = [
  { href: `${base}/`, label: "Decide", detail: "Home", icon: "lucide:radar" },
  {
    href: `${base}/blog`,
    label: "Learn",
    detail: "Notes",
    icon: "lucide:book-open-text",
  },
  {
    href: `${base}/linktree`,
    label: "Explore",
    detail: "Corners",
    icon: "lucide:compass",
  },
];

const home = normalizeRoutePath(`${base}/`);
const currentPath = normalizeRoutePath(pathname);

const isActive = (href: string) => {
  const target = normalizeRoutePath(href);
  if (target === home) return currentPath === home;
  return currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<!doctype html>
<html lang="en" class="dark">
  <Head
    {title}
    {description}
    {canonical}
    {openGraph}
    {twitter}
    {noindex}
    {nofollow}
    {themeColor}
  >
    <ClientRouter />
    <slot name="head" />
  </Head>
  <body class="min-h-screen overflow-x-clip bg-background text-foreground">
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showChrome && <CustomCursor />}
    {showChrome && <ThreeBackground />}
    {
      showChrome && (
        <header class="sticky top-0 z-50 border-b border-border/70 bg-background/72 shadow-[0_18px_64px_rgba(0,0,0,0.34)] backdrop-blur-2xl">
          <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-linear-to-r from-transparent via-neon-cyan to-transparent opacity-80" />
          <div class="pointer-events-none absolute inset-x-0 bottom-0 h-px bg-linear-to-r from-transparent via-neon-magenta via-50% to-transparent opacity-75" />
          <nav aria-label="Primary navigation" class="mx-auto flex max-w-7xl items-center justify-between gap-3 px-4 py-3 sm:px-6">
            <a
              href={`${base}/`}
              class="group neon-panel flex min-h-12 min-w-0 items-center gap-3 px-3 py-2 text-left transition-transform hover:-translate-y-0.5"
              aria-label="ShadowNine home"
            >
              <span class="relative flex size-10 shrink-0 items-center justify-center rounded-lg border border-primary/50 bg-primary/12 text-primary shadow-[0_0_26px_rgba(0,229,255,0.22)]">
                <span class="absolute inset-1 rounded-md border border-accent/35 opacity-70 transition-transform group-hover:rotate-45" />
                <Icon name="lucide:zap" width="18" height="18" class="relative" />
              </span>
              <span class="min-w-0">
                <span class="block truncate text-sm font-black uppercase tracking-[0.18em] text-foreground">
                  ShadowNine
                </span>
                <span class="hidden truncate text-[0.68rem] font-bold uppercase tracking-[0.28em] text-muted-foreground sm:block">
                  midnight workshop
                </span>
              </span>
            </a>

            <div class="neon-panel flex max-w-full items-center gap-1 p-1">
              {navLinks.map(({ href, label, detail, icon }) => {
                const active = isActive(href);

                return (
                  <a
                    href={href}
                    class:list={[
                      "group relative inline-flex min-h-11 items-center justify-center gap-2 rounded-md px-3 py-2 text-sm font-bold transition-all sm:min-w-28 sm:justify-start sm:px-3.5",
                      active
                        ? "bg-primary text-primary-foreground shadow-[0_0_28px_rgba(0,229,255,0.25)]"
                        : "text-muted-foreground hover:bg-muted/70 hover:text-foreground",
                    ]}
                    aria-current={active ? "page" : undefined}
                  >
                    <Icon
                      name={icon}
                      width="17"
                      height="17"
                      class:list={[
                        "shrink-0 transition-transform",
                        active ? "" : "group-hover:-translate-y-0.5 group-hover:scale-110",
                      ]}
                    />
                    <span class="hidden min-w-0 sm:block">
                      <span class="block leading-none">{label}</span>
                      <span
                        class:list={[
                          "mt-1 block text-[0.62rem] uppercase tracking-[0.18em]",
                          active ? "text-primary-foreground/70" : "text-muted-foreground/70",
                        ]}
                      >
                        {detail}
                      </span>
                    </span>
                    <span class="sr-only sm:hidden">{label}</span>
                    {active && (
                      <span class="absolute inset-x-2 -bottom-1 h-px rounded-full bg-primary-foreground/80" />
                    )}
                  </a>
                );
              })}
            </div>
          </nav>
        </header>
      )
    }
    <main id="main-content" class="relative z-10 min-h-[60vh] flex-1">
      <slot />
    </main>
    {showChrome && <Footer />}
  </body>
</html>
