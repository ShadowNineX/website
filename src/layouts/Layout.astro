---
import "../styles/global.css";
import Head from "@/components/Head.astro";
import { ClientRouter } from "astro:transitions";
import { Icon } from "astro-iconify";
import Footer from "@/components/Footer.astro";
import ThreeBackground from "@/components/ThreeBackground.astro";
import { normalizeRoutePath } from "@/lib/routes";
import type { Props as SEOProps } from "astro-seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  openGraph?: SEOProps["openGraph"];
  twitter?: SEOProps["twitter"];
  noindex?: boolean;
  nofollow?: boolean;
  themeColor?: string;
  showChrome?: boolean;
}

const {
  title,
  description,
  canonical,
  openGraph,
  twitter,
  noindex,
  nofollow,
  themeColor,
  showChrome = true,
} = Astro.props;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const navLinks = [
  { href: `${base}/`, label: "Home", icon: "lucide:house" },
  { href: `${base}/blog`, label: "Notes", icon: "lucide:notebook-tabs" },
  { href: `${base}/linktree`, label: "Explore", icon: "lucide:orbit" },
];
const home = normalizeRoutePath(`${base}/`);
const currentPath = normalizeRoutePath(Astro.url.pathname);
const isActive = (href: string) => {
  const target = normalizeRoutePath(href);
  return target === home
    ? currentPath === home
    : currentPath === target || currentPath.startsWith(`${target}/`);
};
---

<!doctype html>
<html lang="en" class="dark">
  <Head
    {title}
    {description}
    {canonical}
    {openGraph}
    {twitter}
    {noindex}
    {nofollow}
    {themeColor}
  >
    <ClientRouter />
    <slot name="head" />
  </Head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showChrome && <ThreeBackground />}
    <div class="site-frame">
      {
        showChrome && (
          <header class="site-header">
            <nav class="site-nav wrap" aria-label="Primary navigation">
              <a class="brand" href={`${base}/`} aria-label="ShadowNine home">
                <span class="brand-mark" aria-hidden="true">
                  <Icon name="lucide:radio-tower" width="19" height="19" />
                </span>
                <span class="brand-copy">
                  <strong>ShadowNine</strong>
                  <span>home signal / workshop light</span>
                </span>
              </a>

              <ul class="nav-list">
                {navLinks.map((link) => (
                  <li>
                    <a
                      class="nav-link"
                      href={link.href}
                      aria-current={isActive(link.href) ? "page" : undefined}
                    >
                      <Icon name={link.icon} width="16" height="16" />
                      <span>{link.label}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </header>
        )
      }
      <main id="main-content">
        <slot />
      </main>
      {showChrome && <Footer />}
    </div>
  </body>
</html>
