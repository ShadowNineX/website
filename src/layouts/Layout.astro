---
import "../styles/global.css";
import "@/styles/themes.css";
import "@/styles/navigation.css";
import Head from "@/components/Head.astro";
import { ClientRouter } from "astro:transitions";
import Footer from "@/components/Footer.astro";
import ThreeBackground from "@/components/ThreeBackground.astro";
import SiteNavigation from "@/components/SiteNavigation.astro";
import { themeConfig } from "@/config/themes";
import type { Props as SEOProps } from "astro-seo";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  openGraph?: SEOProps["openGraph"];
  twitter?: SEOProps["twitter"];
  noindex?: boolean;
  nofollow?: boolean;
  themeColor?: string;
  showChrome?: boolean;
  themeManaged?: boolean;
}

const {
  title,
  description,
  canonical,
  openGraph,
  twitter,
  noindex,
  nofollow,
  themeColor,
  showChrome = true,
  themeManaged = true,
} = Astro.props;

---

<!doctype html>
<html lang="en" class="dark" data-theme-managed={String(themeManaged)} data-theme={themeManaged ? themeConfig.defaultTheme : "tails"}>
  <Head
    {title}
    {description}
    {canonical}
    {openGraph}
    {twitter}
    {noindex}
    {nofollow}
    {themeColor}
    {themeManaged}
  >
    <ClientRouter />
    <slot name="head" />
  </Head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    {showChrome && <ThreeBackground />}
    <div class="site-frame">
      {
        showChrome && (
          <header class="site-header">
            <SiteNavigation />
          </header>
        )
      }
      <main id="main-content">
        <slot />
      </main>
      {showChrome && <Footer />}
    </div>
  </body>
</html>
