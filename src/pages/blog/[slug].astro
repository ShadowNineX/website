---
import Layout from "@/layouts/Layout.astro";
import { getCollection, render } from "astro:content";
import { Icon } from "astro-iconify";
import { Image } from "astro:assets";
import { getSeoImage } from "@/lib/seo-image";
import { canonicalUrlForPath } from "@/lib/routes";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalUrl = canonicalUrlForPath(Astro.url.pathname, Astro.site ?? Astro.url);
const postImage = post.data.image;
const imageAlt = post.data.imageAlt ?? post.data.title;
const ogImage = await getSeoImage({ image: postImage, requestUrl: Astro.url, site: Astro.site, width: 1200, height: 630 });
const ogImageUrl = ogImage?.url;
const fallbackOgImageUrl = "https://github.com/ShadowNineX.png?size=512";
const formattedDate = post.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title={post.data.title}
  description={post.data.description}
  canonical={canonicalUrl}
  openGraph={{
    basic: { title: post.data.title, type: "article", url: canonicalUrl, image: ogImageUrl ?? fallbackOgImageUrl },
    optional: { description: post.data.description, siteName: "ShadowNine", locale: "en_US" },
    ...(ogImageUrl && { image: { secureUrl: ogImageUrl, type: ogImage.type, width: ogImage.width, height: ogImage.height, alt: imageAlt } }),
    article: { publishedTime: post.data.date.toISOString(), authors: [post.data.author] },
  }}
  twitter={ogImageUrl ? { card: "summary_large_image", title: post.data.title, description: post.data.description, image: ogImageUrl, imageAlt } : undefined}
>
  <article class="article-shell wrap">
    <a class="button-soft" href={`${base}/blog`}>
      <Icon name="lucide:arrow-left" width="15" height="15" />
      Back to notes
    </a>

    <header class="article-header">
      <div>
        <div class="note-meta">
          <time transition:name={`blog-date-${post.id}`} transition:animate="initial">{formattedDate}</time>
          <span>@{post.data.author}</span>
          <span>workshop note</span>
        </div>
        <h1 class="article-title" transition:name={`blog-title-${post.id}`} transition:animate="initial">{post.data.title}</h1>
        <p class="article-deck" transition:name={`blog-description-${post.id}`} transition:animate="initial">{post.data.description}</p>
      </div>
      {postImage && (
        <Image
          src={postImage}
          alt={imageAlt}
          width={1200}
          height={630}
          loading="eager"
          transition:name={`blog-image-${post.id}`}
          transition:animate="initial"
          class="article-image"
        />
      )}
    </header>

    <div class="article-grid">
      <aside class="article-aside" aria-label="Publication details">
        <div>Published<strong>{formattedDate}</strong></div>
        <div>Written by<strong>@{post.data.author}</strong></div>
      </aside>
      <div class="article-prose">
        <div class="blog-prose"><Content /></div>
        <footer style="margin-top: 3rem; border-top: 1px solid var(--line); padding-top: 1.5rem;">
          <a class="text-link" href={`${base}/blog`}>
            <Icon name="lucide:arrow-left" width="15" height="15" /> All notes
          </a>
        </footer>
      </div>
    </div>
  </article>
</Layout>
