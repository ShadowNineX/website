---
import Layout from "@/layouts/Layout.astro";
import { Icon } from "astro-iconify";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Layout title="Page Not Found" description="The page you were looking for could not be found." noindex>
  <section class="not-found wrap page-section">
    <div class="error-dial" aria-hidden="true"><strong>404</strong></div>
    <div>
      <h1 class="page-title">This orbit came back <em>empty.</em></h1>
      <p class="lede">The link may be old, the URL may have a typo, or the workshop shelves moved while nobody was looking. The useful rooms are still close.</p>
      <div class="button-row">
        <a class="button" href={`${base}/`}><Icon name="lucide:house" width="16" height="16" /> Return home</a>
        <a class="button-soft" href={`${base}/blog`}><Icon name="lucide:notebook-tabs" width="16" height="16" /> Open notes</a>
      </div>
    </div>
  </section>
</Layout>
