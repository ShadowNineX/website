---
import { Image, getImage } from "astro:assets";
import gta6Sunset from "@/assets/themes/gta6-afterglow.png";
import tailsWorkshop from "@/content/blog/tails-trust-tools-home.png";
import { Icon } from "astro-iconify";
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import "@/styles/home-workshop.css";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const gta6Hero = await getImage({ src: gta6Sunset, width: 2304, format: "webp", quality: 88 });
const githubUsername = "ShadowNineX";
const githubProfileUrl = `https://github.com/${githubUsername}`;
const githubAvatarUrl = `${githubProfileUrl}.png?size=512`;
const blogPosts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const latestBlogPost = blogPosts[0];

interface GitHubUser {
  login: string;
  name: string | null;
  bio: string | null;
  public_repos: number;
  created_at: string;
}
interface GitHubRepo {
  name: string;
  description: string | null;
  html_url: string;
  language: string | null;
  stargazers_count: number;
  pushed_at: string;
}

const fetchGitHubJson = async <T,>(url: string): Promise<T | null> => {
  const token = import.meta.env.GITHUB_TOKEN as string | undefined;
  try {
  let response = await fetch(url, {
    headers: {
      Accept: "application/vnd.github+json",
      "X-GitHub-Api-Version": "2022-11-28",
      ...(token ? { Authorization: `Bearer ${token}` } : {}),
    },
  });
  if ((response.status === 401 || response.status === 403) && token) {
    response = await fetch(url, {
      headers: {
        Accept: "application/vnd.github+json",
        "X-GitHub-Api-Version": "2022-11-28",
      },
    });
  }
  if (!response.ok) {
    console.warn(`GitHub API request failed: ${response.status} for ${url} - continuing without it.`);
    return null;
  }
  return (await response.json()) as T;
  } catch (error) {
    console.warn(`GitHub API request failed for ${url} - continuing without it.`, error);
    return null;
  }
};

const [githubUserData, githubRepoData] = await Promise.all([
  fetchGitHubJson<GitHubUser>(`https://api.github.com/users/${githubUsername}`),
  fetchGitHubJson<GitHubRepo[]>(`https://api.github.com/users/${githubUsername}/repos?sort=updated&per_page=100`),
]);
const githubUser: GitHubUser = githubUserData ?? {
  login: githubUsername,
  name: null,
  bio: null,
  public_repos: 0,
  created_at: new Date().toISOString(),
};
const githubRepos: GitHubRepo[] = githubRepoData ?? [];
const displayName = githubUser.name ?? githubUser.login;
const profileBio = githubUser.bio ?? "Developer, builder, tinkerer.";
const totalStars = githubRepos.reduce((sum, repo) => sum + repo.stargazers_count, 0);
const formatMonthYear = (date: string) =>
  new Intl.DateTimeFormat("en", { month: "short", year: "numeric" }).format(new Date(date));
const formatBlogDate = (date: Date) =>
  new Intl.DateTimeFormat("en", { month: "long", day: "numeric", year: "numeric" }).format(date);

const profileStats = [
  { label: "public repos", value: githubUser.public_repos.toString() },
  { label: "GitHub stars", value: totalStars.toString() },
  { label: "building since", value: formatMonthYear(githubUser.created_at) },
];
const focusAreas = [
  {
    title: "AI-assisted tools",
    description: "MCP-powered tools for developer workflows, game tooling, and reverse-engineering projects.",
  },
  {
    title: "Game and modding work",
    description: "Unreal Engine, Portal 2: Community Edition, Cheat Engine, Neodash, Rising World, and the toolchains behind playable ideas.",
  },
  {
    title: "Personal web experiments",
    description: "Astro and Vue sites, editor experiments, and TypeScript projects that feel cozy, useful, or weird enough to try.",
  },
];
const tailsCompanionNotes = [
  {
    title: "Make something useful",
    description: "A clever mechanism or careful patch matters most when it clears the way for somebody else.",
  },
  {
    title: "Stay with the stubborn bits",
    description: "Trace the strange rattle or failing test until the problem makes sense and the fix earns trust.",
  },
  {
    title: "Share the good part",
    description: "Bright flights, mint candy, game nights, and building beside Alex are better together.",
  },
];
const projectIcons: Record<string, string> = {
  "ce-mcp": "lucide:cpu",
  CESDK: "lucide:plug",
  headbreaker: "lucide:puzzle",
  "vscode-eta": "lucide:braces",
  "p2ce-hono-web-server": "lucide:server",
  "wallpaper-engine": "lucide:monitor-play",
  "MCP-UAsset-Toolkit": "lucide:wrench",
  ToSteamArtwork: "lucide:image",
};
const projectMeta: Record<string, string> = {
  "p2ce-hono-web-server": "Portal 2 CE",
  "wallpaper-engine": "npm package",
  "MCP-UAsset-Toolkit": "Unreal Engine",
  ToSteamArtwork: "Steam tools",
};
const projectDescription: Record<string, string> = {
  "ce-mcp": "A C# MCP bridge for automating Cheat Engine with AI—the most-starred public project on the profile.",
  "MCP-UAsset-Toolkit": "Automation for Unreal Engine reverse engineering with UAsset API, CUE4Parse, MCP, and AI-assisted workflows.",
  ToSteamArtwork: "A TypeScript utility that converts images, GIFs, and videos to Steam artwork dimensions.",
};
const projects = githubRepos
  .filter((repo) => repo.description)
  .sort((a, b) => b.stargazers_count - a.stargazers_count || new Date(b.pushed_at).getTime() - new Date(a.pushed_at).getTime())
  .slice(0, 6)
  .map((repo) => ({
    name: repo.name,
    description: projectDescription[repo.name] ?? repo.description ?? "A public GitHub project from ShadowNine.",
    href: repo.html_url,
    language: repo.language ?? "Code",
    meta: projectMeta[repo.name] ?? `${repo.stargazers_count} ${repo.stargazers_count === 1 ? "star" : "stars"}`,
    icon: projectIcons[repo.name] ?? "lucide:folder-git-2",
  }));
const stackGroups = [
  {
    title: "Languages",
    items: [
      ["TypeScript", "simple-icons:typescript", "#4598e6"], ["C#", "simple-icons:csharp", "#bd8cf4"], ["C++", "simple-icons:cplusplus", "#67a9df"],
      ["Kotlin", "simple-icons:kotlin", "#ad80ff"], ["Go", "simple-icons:go", "#00c5e5"], ["Lua", "simple-icons:lua", "#96aaff"], ["Python", "simple-icons:python", "#f4cf67"],
    ],
  },
  {
    title: "Frontend",
    items: [
      ["Astro", "simple-icons:astro", "#ff825c"], ["Vue", "simple-icons:vuedotjs", "#42c995"], ["Tailwind CSS", "simple-icons:tailwindcss", "#38bdf8"],
      ["shadcn-vue", "lucide:layers-3", "#eeaacb"], ["Vite", "simple-icons:vite", "#ba94ff"],
    ],
  },
  {
    title: "Tools",
    items: [
      ["Bun", "simple-icons:bun", "#f3d1a8"], [".NET", "simple-icons:dotnet", "#b49aff"], ["CMake", "simple-icons:cmake", "#78d39b"],
      ["Unreal Engine", "simple-icons:unrealengine", "#a3baff"], ["MCP", "lucide:bot", "#71e7dc"],
    ],
  },
];
---

<Layout
  title={displayName}
  description={`${displayName}'s luminous workshop for projects, game tooling, music, and small notes.`}
>
  <section class="home-hero wrap" style={{ "--gta6-hero-image": `url("${gta6Hero.src}")` }}>
    <div class="hero-copy">
      <h1 class="display-title"><span class="hero-title-line">A home for bright</span>{" "}<span class="hero-title-line">ideas and <em>useful sparks.</em></span></h1>
      <p class="lede">
        I'm {displayName}, a developer building tools, modding experiments, cozy web pages, and odd ideas that need somewhere warm to land. Come in—the music is nearby and the workbench is open.
      </p>
      <div class="button-row">
        <a class="button" href={`${githubProfileUrl}?tab=repositories`}>
          <Icon name="simple-icons:github" width="16" height="16" />
          Browse the builds
        </a>
        <a class="button-soft" href={`${base}/blog`}>
          <Icon name="lucide:notebook-tabs" width="16" height="16" />
          Read the notes
        </a>
      </div>
    </div>

    <aside class="observatory-card panel-tactile" aria-label="ShadowNine profile">
      <div class="profile-image-wrap">
        <Image
          src={githubAvatarUrl}
          alt={`${displayName} GitHub avatar`}
          width={512}
          height={512}
          loading="eager"
          class="profile-image"
        />
      </div>
      <div class="profile-copy">
        <h2>{displayName}</h2>
        <p>{profileBio}</p>
        <dl class="stat-row">
          {profileStats.map((stat) => (
            <div class="stat-chip">
              <dt>{stat.label}</dt>
              <dd>{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </aside>
  </section>

  <section class="focus-strip" aria-label="Current focus areas">
    <div class="focus-intro">
      <h2>What I keep coming back to</h2>
      <p>Tools, playable ideas, and web experiments with a reason to exist.</p>
    </div>
    <div class="focus-list">
      {focusAreas.map((area) => (
      <article class="focus-item">
        <h2>{area.title}</h2>
        <p>{area.description}</p>
      </article>
    ))}
    </div>
  </section>

  <section class="companion-section wrap" aria-labelledby="companion-title">
    <div class="companion-stage">
      <Image
        class="companion-art"
        src={tailsWorkshop}
        alt="Tails holding a wrench beside an open notebook in a warmly lit workshop."
        width={1693}
        height={929}
        widths={[640, 960, 1440, 1693]}
        sizes="(max-width: 680px) 100vw, (max-width: 1200px) 75vw, 1000px"
        loading="lazy"
      />
      <div class="companion-copy">
        <h2 id="companion-title">I'm here—let's figure it out <em>together.</em></h2>
        <p>Two warm lights from one shared room: the notebook is open, careful work is welcome, and there is space at the bench for the next idea.</p>
        <a class="companion-link" href={`${base}/blog/tails-trust-tools-home`}>
          <Icon name="lucide:book-heart" width="20" height="20" aria-hidden="true" />
          Read Tails's note
          <Icon name="lucide:arrow-up-right" width="19" height="19" aria-hidden="true" />
        </a>
      </div>
    </div>
    <div class="companion-notes">
      {tailsCompanionNotes.map((note) => (
        <article class="companion-note">
          <h3>{note.title}</h3>
          <p>{note.description}</p>
        </article>
      ))}
    </div>
  </section>

  {latestBlogPost && (
    <section class="page-section wrap">
      <div class="section-heading">
        <div>
          <h2 class="section-title">A note still warm from the <em>bench.</em></h2>
        </div>
        <a class="text-link" href={`${base}/blog`}>
          Open the full notebook <Icon name="lucide:arrow-up-right" width="15" height="15" />
        </a>
      </div>
      <a class="feature-note panel-tactile" href={`${base}/blog/${latestBlogPost.id}`}>
        {latestBlogPost.data.image && (
          <Image
            src={latestBlogPost.data.image}
            alt={latestBlogPost.data.imageAlt ?? ""}
            width={1200}
            height={630}
            loading="eager"
            transition:name={`blog-image-${latestBlogPost.id}`}
            transition:animate="initial"
          />
        )}
        <div class="feature-note-copy">
          <div class="note-meta">
            <time transition:name={`blog-date-${latestBlogPost.id}`} transition:animate="initial">
              {formatBlogDate(latestBlogPost.data.date)}
            </time>
            <span>@{latestBlogPost.data.author}</span>
          </div>
          <h3 transition:name={`blog-title-${latestBlogPost.id}`} transition:animate="initial">
            {latestBlogPost.data.title}
          </h3>
          <p transition:name={`blog-description-${latestBlogPost.id}`} transition:animate="initial">
            {latestBlogPost.data.description}
          </p>
          <span class="text-link" style="margin-top: 1.5rem;">Read the note <Icon name="lucide:arrow-right" width="15" height="15" /></span>
        </div>
      </a>
    </section>
  )}

  <section class="page-section wrap">
    <div class="section-heading">
      <div>
        <h2 class="section-title">Tools with fingerprints on <em>the casing.</em></h2>
      </div>
      <a class="text-link" href={`${githubProfileUrl}?tab=repositories`}>
        All repositories <Icon name="lucide:arrow-up-right" width="15" height="15" />
      </a>
    </div>
    <div class="project-grid">
      {projects.map((project) => (
        <a class="project-card" href={project.href} target="_blank" rel="noopener noreferrer">
          <div class="project-top">
            <span class="project-icon"><Icon name={project.icon} width="20" height="20" /></span>
            <span class="project-meta">{project.language} / {project.meta}</span>
          </div>
          <h3>{project.name}</h3>
          <p>{project.description}</p>
        </a>
      ))}
    </div>
  </section>

  <section class="page-section wrap">
    <div class="stack-board panel">
      <div class="stack-copy">
        <h2 class="section-title">Follow the idea. Make it useful.</h2>
        <p>Recent work crosses AI bots, VS Code language tooling, web wallpaper infrastructure, MCP automation, and game modding. The common thread is keeping the parts worth returning to.</p>
      </div>
      <div class="stack-groups">
        {stackGroups.map((group) => (
          <section>
            <h3>{group.title}</h3>
            <ul>
              {group.items.map(([label, icon, color]) => (
                <li><Icon class="stack-icon" name={icon} width="20" height="20" style={`color: ${color}`} aria-hidden="true" /> {label}</li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    </div>
  </section>
</Layout>
