              {area.title}
            </h2>
            <p class="mt-2 text-sm leading-6 text-muted-foreground">
              {area.description}
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <section class="section-beam mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
      <article class="synth-card p-5">
        <div class="inline-flex items-center gap-3 rounded-md border border-neon-cyan/30 bg-neon-cyan/12 px-3 py-2 text-neon-cyan dark:text-neon-cyan">
          <span class="relative flex h-6 w-8 items-center justify-center" aria-hidden="true">
            <span class="absolute left-0.5 size-3 rounded-full border-2 border-accent bg-solar shadow-[0_0_10px_rgba(250,204,21,0.65)]"></span>
            <span class="absolute right-0.5 size-3 rounded-full border-2 border-solar bg-accent shadow-[0_0_10px_rgba(251,146,60,0.6)]"></span>
          </span>
          <span class="text-sm font-medium">Twin-Tail Signal</span>
        </div>
        <h2 class="mt-4 text-2xl font-bold tracking-tight">
          I'm here—let's figure it out together.
