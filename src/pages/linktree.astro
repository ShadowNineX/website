---
import { Image, getImage } from "astro:assets";
import { Icon } from "astro-iconify";
import backgroundAvatar from "@/assets/linktree-background-avatar.gif";
import flyingStill from "@/assets/explore/flying-still.png";
import gta6Hero from "@/assets/explore/hero-gta6.png";
import tailsHero from "@/assets/explore/hero-tails.png";
import Layout from "@/layouts/Layout.astro";
import "@/styles/linktree.css";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const githubUsername = "ShadowNineX";
const githubProfileUrl = `https://github.com/${githubUsername}`;
const githubAvatarUrl = `${githubProfileUrl}.png?size=256`;
const displayName = "ShadowNine";
const profileBio = "A small shelf of project, social, and music links.";
const links = [
  {
    label: "GitHub",
    href: githubProfileUrl,
    description: "Repositories, experiments, and project source.",
    icon: "simple-icons:github",
    color: "#71e7ec",
    group: "Code",
  },
  {
    label: "SpaceHey",
    href: "https://spacehey.com/shadownine",
    description: "A little corner for profiles, posts, and friends.",
    icon: "lucide:users",
    color: "#c9a5ff",
    group: "Social",
  },
  {
    label: "Last.fm",
    href: "https://www.last.fm/user/ShadowNineX",
    description: "A quiet record of recently played music.",
    icon: "simple-icons:lastdotfm",
    color: "#ff8f70",
    group: "Music",
    widget: {
      src: "https://lastfm-recently-played.vercel.app/api?user=ShadowNineX&header_style=normal_stats&footer_style=wave&maxage=60&loved=true",
      alt: "Last.fm recently played",
    },
  },
  {
    label: "Spotify",
    href: "https://open.spotify.com/user/31wl2m3aqxcky555yhqi7epzau7u",
    description: "Comfort tracks and now playing.",
    icon: "simple-icons:spotify",
    color: "#78e0ae",
    group: "Music",
    widget: {
      src: "https://spotify-github-profile.kittinanx.com/api/view?uid=31wl2m3aqxcky555yhqi7epzau7u&cover_image=true&theme=default&show_offline=false&background_color=121212&interchange=false&profanity=false&bar_color=3d8b37",
      alt: "Spotify now playing",
    },
  },
];
const [gta6Art, tailsArt] = await Promise.all([
  getImage({ src: gta6Hero, width: 1280, format: "webp", quality: 85 }),
  getImage({ src: tailsHero, width: 1280, format: "webp", quality: 85 }),
]);
const musicLinks = links.filter((link) => link.widget);
---

<Layout title="Explore" description={`Project, social, and music links from ${displayName}.`}>
  <div class="link-hub" style={`--hub-art-gta6: url('${gta6Art.src}'); --hub-art-tails: url('${tailsArt.src}');`}>
    <div class="hub-landing wrap">
      <header class="hub-identity">
        <div class="hub-identity-copy">
          <Image src={githubAvatarUrl} alt={`${displayName} GitHub avatar`} width={64} height={64} loading="eager" class="hub-avatar" />
          <h1>{displayName}</h1>
          <p>@{githubUsername}</p>
        </div>
      </header>

      <section class="hub-directory" aria-labelledby="hub-intro">
        <div>
          <h2 id="hub-intro">A few good corners of the <em>same sky.</em></h2>
          <p class="hub-intro">Follow the build trail, stop by SpaceHey, or check what has been playing.</p>
        </div>
        <ul class="hub-destinations" aria-label="Find me elsewhere">
          {links.map((link) => (
            <li class:list={{ "hub-destination--music": link.group === "Music" }}>
              <a class="hub-destination" href={link.href} target="_blank" rel="noopener noreferrer" style={`--destination-color: ${link.color};`}>
                <Icon class="hub-destination-icon" name={link.icon} width={32} height={32} aria-hidden="true" />
                <span class="hub-destination-copy"><strong>{link.label}</strong><small>{link.description}</small></span>
                <Icon class="hub-outward" name="lucide:arrow-up-right" width={21} height={21} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>
      </section>
    </div>

    <section class="hub-listening wrap" aria-labelledby="hub-listening-title">
      <div class="hub-listening-heading">
        <h2 id="hub-listening-title">Stay for the music.</h2>
        <p>{profileBio}</p>
      </div>
      <div class="hub-players">
        {musicLinks.map((link) => (
          <article class="hub-player">
            <a class="hub-player-title" href={link.href} target="_blank" rel="noopener noreferrer">
              <Icon name={link.icon} width={23} height={23} aria-hidden="true" />
              <h3>{link.label}</h3>
              <Icon name="lucide:arrow-up-right" width={18} height={18} aria-hidden="true" />
            </a>
            {link.widget && <a class="hub-widget-link" href={link.href} target="_blank" rel="noopener noreferrer">
              <img src={link.widget.src} alt={link.widget.alt} width={link.label === "Last.fm" ? 400 : 320} height={link.label === "Last.fm" ? 394 : 445} loading="lazy" class="hub-widget" />
            </a>}
            <p>{link.description}</p>
          </article>
        ))}
      </div>
    </section>

    <aside class="hub-signoff wrap">
      <picture class="hub-flying">
        <source srcset={flyingStill.src} media="(prefers-reduced-motion: reduce)" />
        <Image src={backgroundAvatar} alt="" width={672} height={240} loading="lazy" />
      </picture>
      <div>
        <p>Kept small on purpose: a project door, a social corner, and a place for music.</p>
        <a class="hub-home" href={`${base}/`}><Icon name="lucide:arrow-left" width={18} height={18} aria-hidden="true" /> Back home</a>
      </div>
    </aside>
  </div>
</Layout>
