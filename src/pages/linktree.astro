---
import { Image } from "astro:assets";
import { Icon } from "astro-iconify";
import backgroundAvatar from "@/assets/linktree-background-avatar.gif";
import Layout from "@/layouts/Layout.astro";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const githubUsername = "ShadowNineX";
const githubProfileUrl = `https://github.com/${githubUsername}`;
const githubAvatarUrl = `${githubProfileUrl}.png?size=256`;
const displayName = "ShadowNine";
const profileBio = "A small shelf of project, social, and music links.";
const links = [
  {
    label: "GitHub",
    href: githubProfileUrl,
    description: "Repositories, experiments, and project source.",
    icon: "simple-icons:github",
    color: "#71e7ec",
    group: "Code",
  },
  {
    label: "SpaceHey",
    href: "https://spacehey.com/shadowninex",
    description: "A little corner for profiles, posts, and friends.",
    icon: "lucide:users",
    color: "#c9a5ff",
    group: "Social",
  },
  {
    label: "Last.fm",
    href: "https://www.last.fm/user/ShadowNineX",
    description: "A quiet record of recently played music.",
    icon: "simple-icons:lastdotfm",
    color: "#ff8f70",
    group: "Music",
    widget: {
      src: "https://lastfm-recently-played.vercel.app/api?user=ShadowNineX&header_style=normal_stats&footer_style=wave&maxage=60&loved=true",
      alt: "Last.fm recently played",
    },
  },
  {
    label: "Spotify",
    href: "https://open.spotify.com/user/31wl2m3aqxcky555yhqi7epzau7u",
    description: "Comfort tracks and now playing.",
    icon: "simple-icons:spotify",
    color: "#78e0ae",
    group: "Music",
    widget: {
      src: "https://spotify-github-profile.kittinanx.com/api/view?uid=31wl2m3aqxcky555yhqi7epzau7u&cover_image=true&theme=default&show_offline=false&background_color=121212&interchange=false&profanity=false&bar_color=3d8b37",
      alt: "Spotify now playing",
    },
  },
];
const groupOrder = ["Code", "Social", "Music"];
---

<Layout title="Explore" description={`Project, social, and music links from ${displayName}.`}>
  <section class="page-section wrap">
    <div class="explore-grid">
      <header class="explore-profile panel-tactile">
        <Image src={backgroundAvatar} alt="" width={672} height={240} loading="eager" class="explore-banner" />
        <div class="explore-profile-copy">
          <Image src={githubAvatarUrl} alt={`${displayName} GitHub avatar`} width="112" height="112" loading="eager" class="explore-avatar" />
          <p class="profile-handle">@{githubUsername}</p>
          <h1>{displayName}</h1>
          <p>{profileBio} Kept small on purpose: a project door, a social corner, and a place for music.</p>
          <a class="button-soft" href={`${base}/`} style="margin-top: 1.2rem;">
            <Icon name="lucide:arrow-left" width="15" height="15" /> Back home
          </a>
        </div>
      </header>

      <div>
        <h1 class="page-title">A few good corners of the <em>same sky.</em></h1>
        <p class="lede">Follow the build trail, stop by SpaceHey, or check what has been playing.</p>

        <div class="link-groups" style="margin-top: 3rem;">
          {groupOrder.map((group) => {
            const groupLinks = links.filter((link) => link.group === group);
            return (
              <section id={group.toLowerCase()}>
                <h2 class="link-group-title"><span>{group}</span><span>{groupLinks.length} {groupLinks.length === 1 ? "corner" : "corners"}</span></h2>
                <ul class="link-cards">
                  {groupLinks.map((link) => (
                    <li>
                      <a class="link-card" href={link.href} target="_blank" rel="noopener noreferrer" style={`--link-color: ${link.color};`}>
                        <div class="link-card-main">
                          <span class="link-icon"><Icon name={link.icon} width="20" height="20" /></span>
                          <span><strong>{link.label}</strong><small>{link.description}</small></span>
                          <Icon name="lucide:arrow-up-right" width="16" height="16" />
                        </div>
                        {link.widget && <img src={link.widget.src} alt={link.widget.alt} loading="lazy" class="link-widget" />}
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })}
        </div>
      </div>
    </div>
  </section>
</Layout>
