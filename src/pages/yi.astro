---
import { Image } from "astro:assets";
import { Icon } from "astro-iconify";
import Layout from "@/layouts/Layout.astro";
import { canonicalUrlForPath } from "@/lib/routes";
import { getSeoImage } from "@/lib/seo-image";
import yiImage from "@/assets/yi.jpg";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const title = "Yi Mode";
const description = "A tiny glowing tribute page for Yi, the workshop's most serious little guardian.";
const imageAlt = "White cat-like Yi character wearing a yellow coat with a glowing green chest ring.";
const themeColor = "#ffd166";
const canonicalUrl = canonicalUrlForPath(Astro.url.pathname, Astro.site ?? Astro.url);
const seoImage = await getSeoImage({ image: yiImage, requestUrl: Astro.url, site: Astro.site });
const imageUrl = seoImage?.url ?? new URL(yiImage.src, Astro.url).href;
const statusCards = [
  { label: "Signal", value: "Locked", icon: "lucide:radar" },
  { label: "Mood", value: "Judging", icon: "lucide:eye" },
  { label: "Coat", value: "Maximum", icon: "lucide:sparkles" },
];
const tags = ["micro-boss", "gold jacket", "green core", "silent alarm"];
---

<Layout
  {title}
  {description}
  canonical={canonicalUrl}
  {themeColor}
  showChrome={false}
  openGraph={{
    basic: { title, type: "website", image: imageUrl, url: canonicalUrl },
    optional: { description, siteName: "ShadowNine", locale: "en_US" },
    image: { secureUrl: imageUrl, type: seoImage?.type ?? "image/jpeg", width: seoImage?.width ?? yiImage.width, height: seoImage?.height ?? yiImage.height, alt: imageAlt },
  }}
  twitter={{ card: "summary_large_image", title, description, image: imageUrl, imageAlt }}
>
  <section class="yi-stage">
    <div class="yi-stars" aria-hidden="true"></div>
    <div class="yi-shell">
      <div class="yi-copy">
        <div class="yi-topline">
          <a href={`${base}/`}><Icon name="lucide:arrow-left" width="15" height="15" /> Workshop</a>
          <span><i></i> Guardian online</span>
        </div>
        <p class="yi-kicker">Special observatory channel / YI-01</p>
        <h1>Yi has entered the workshop.</h1>
        <p class="yi-lede">Small frame. Huge coat. Zero patience for boring pages. This corner runs on warm light, tiny boss energy, and one very serious green core.</p>
        <div class="yi-tags">
          {tags.map((tag) => <span>#{tag}</span>)}
        </div>
        <dl class="yi-status">
          {statusCards.map((card) => (
            <div>
              <Icon name={card.icon} width="19" height="19" />
              <dt>{card.label}</dt>
              <dd>{card.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="yi-portrait">
        <div class="yi-orbit" aria-hidden="true"></div>
        <div class="yi-camera">
          <div class="yi-camera-bar"><span>Yi cam</span><span><i></i> live</span></div>
          <Image src={yiImage} alt={imageAlt} width={900} loading="eager" />
          <figcaption>
            <span><small>Threat level</small><strong>Adorable menace</strong></span>
            <b>core: stable</b>
          </figcaption>
        </div>
      </figure>
    </div>
  </section>
</Layout>

<style>
  .yi-stage {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 82% 18%, rgb(120 224 174 / 0.18), transparent 28rem),
      radial-gradient(circle at 10% 12%, rgb(255 209 102 / 0.24), transparent 32rem),
      linear-gradient(145deg, #25150d, #171327 55%, #0d1327);
    color: #fffaf0;
  }

  .yi-stars {
    position: absolute;
    inset: 0;
    opacity: 0.35;
    background-image:
      radial-gradient(circle at 20% 40%, #ffd166 0 1px, transparent 1.5px),
      radial-gradient(circle at 72% 15%, #78e0ae 0 1px, transparent 1.5px),
      radial-gradient(circle at 55% 80%, #fffaf0 0 1px, transparent 1.5px);
    background-size: 240px 240px, 330px 330px, 430px 430px;
  }

  .yi-shell {
    position: relative;
    z-index: 1;
    display: grid;
    width: min(100% - 2rem, 74rem);
    min-height: 100svh;
    grid-template-columns: minmax(0, 0.9fr) minmax(22rem, 1.1fr);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: center;
    margin-inline: auto;
    padding-block: 3rem;
  }

  .yi-topline {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
  }

  .yi-topline a,
  .yi-topline span {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    border: 1px solid rgb(255 250 240 / 0.2);
    border-radius: 999px;
    background: rgb(255 250 240 / 0.06);
    padding: 0.55rem 0.8rem;
    font-size: 0.76rem;
    font-weight: 750;
    text-decoration: none;
  }

  .yi-topline span { color: #78e0ae; }
  .yi-topline i,
  .yi-camera-bar i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
    background: currentColor;
    box-shadow: 0 0 11px currentColor;
  }

  .yi-kicker {
    margin: 2.5rem 0 0;
    color: #ffd166;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .yi-copy h1 {
    max-width: 10ch;
    margin: 0.85rem 0 0;
    font-family: var(--font-display);
    font-size: clamp(3.5rem, 7vw, 7rem);
    font-weight: 650;
    letter-spacing: -0.055em;
    line-height: 0.88;
  }

  .yi-lede {
    max-width: 40rem;
    margin: 1.4rem 0 0;
    color: rgb(255 250 240 / 0.72);
    font-size: 1.08rem;
    line-height: 1.75;
  }

  .yi-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.4rem;
  }

  .yi-tags span {
    border: 1px solid rgb(255 209 102 / 0.24);
    border-radius: 999px;
    background: rgb(255 209 102 / 0.07);
    padding: 0.4rem 0.65rem;
    color: rgb(255 250 240 / 0.78);
    font-size: 0.76rem;
  }

  .yi-status {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
    margin: 2rem 0 0;
  }

  .yi-status div {
    border: 1px solid rgb(255 209 102 / 0.2);
    border-radius: 1rem;
    background: rgb(255 209 102 / 0.07);
    padding: 1rem;
  }

  .yi-status svg { color: #ffd166; }
  .yi-status dt {
    margin-top: 1rem;
    color: rgb(255 250 240 / 0.55);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .yi-status dd { margin: 0.15rem 0 0; font-weight: 800; }

  .yi-portrait { position: relative; margin: 0; }
  .yi-orbit {
    position: absolute;
    inset: -8% -12%;
    border: 1px solid rgb(255 209 102 / 0.3);
    border-radius: 50%;
    rotate: -13deg;
  }

  .yi-camera {
    position: relative;
    overflow: hidden;
    border: 1px solid rgb(255 209 102 / 0.42);
    border-radius: 2rem 2rem 0.7rem 2rem;
    background: #0e1125;
    box-shadow: 10px 12px 0 rgb(120 224 174 / 0.13), 0 35px 100px rgb(0 0 0 / 0.45);
  }

  .yi-camera-bar {
    position: absolute;
    z-index: 2;
    top: 0;
    right: 0;
    left: 0;
    display: flex;
    justify-content: space-between;
    border-bottom: 1px solid rgb(255 250 240 / 0.15);
    background: rgb(8 10 26 / 0.72);
    padding: 0.8rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    backdrop-filter: blur(12px);
  }

  .yi-camera-bar span:last-child { display: flex; align-items: center; gap: 0.4rem; color: #78e0ae; }
  .yi-camera img { width: 100%; aspect-ratio: 1; object-fit: cover; }
  .yi-camera figcaption {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    background: linear-gradient(transparent, rgb(8 10 26 / 0.92));
    padding: 7rem 1.2rem 1.2rem;
  }
  .yi-camera small,
  .yi-camera strong { display: block; }
  .yi-camera small { color: #78e0ae; font-family: var(--font-mono); font-size: 0.62rem; text-transform: uppercase; }
  .yi-camera strong { margin-top: 0.25rem; font-family: var(--font-display); font-size: 1.8rem; line-height: 1; }
  .yi-camera b { border: 1px solid rgb(120 224 174 / 0.35); border-radius: 999px; background: rgb(120 224 174 / 0.1); color: #78e0ae; padding: 0.55rem 0.7rem; font-size: 0.72rem; }

  @media (prefers-reduced-motion: no-preference) {
    .yi-portrait { animation: yi-float 5s ease-in-out infinite; }
  }
  @keyframes yi-float { 50% { translate: 0 -0.6rem; } }

  @media (max-width: 850px) {
    .yi-shell { grid-template-columns: 1fr; }
    .yi-portrait { order: -1; width: min(100%, 32rem); margin-inline: auto; }
    .yi-copy h1 { max-width: 12ch; }
  }
  @media (max-width: 520px) {
    .yi-shell { width: min(100% - 1.25rem, 74rem); padding-block: 1rem 3rem; }
    .yi-status { grid-template-columns: 1fr; }
    .yi-camera { border-radius: 1.2rem; box-shadow: 5px 6px 0 rgb(120 224 174 / 0.13), 0 25px 70px rgb(0 0 0 / 0.4); }
    .yi-camera figcaption { align-items: start; flex-direction: column; }
    .yi-camera strong { font-size: 1.4rem; }
  }
</style>
