---
import Layout from "@/layouts/Layout.astro";
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-iconify";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const blogDescription = "Project notes, workshop letters, and small field reports from ShadowNine and Tails.";
const blogOgImageOrigin = import.meta.env.DEV ? Astro.url.origin : (Astro.site?.origin ?? Astro.url.origin);
const blogOgImageUrl = new URL(`${base}/og/blog.png`, blogOgImageOrigin).href;
const featuredPost = posts[0];
const archivePosts = posts.slice(1);
const formatDate = (date: Date) =>
  date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" });
---

<Layout
  title="Notes"
  description={blogDescription}
  openGraph={{
    basic: { title: "Notes", type: "website", image: blogOgImageUrl, url: new URL(`${base}/blog`, blogOgImageOrigin).href },
    optional: { description: blogDescription, siteName: "ShadowNine", locale: "en_US" },
    image: { secureUrl: blogOgImageUrl, type: "image/png", width: 1200, height: 630, alt: "ShadowNine notes shelf images" },
  }}
  twitter={{ card: "summary_large_image", title: "Notes", description: blogDescription, image: blogOgImageUrl, imageAlt: "ShadowNine notes shelf images" }}
>
  <header class="page-hero wrap">
    <p class="eyebrow">Workshop letters / transmission archive</p>
    <h1 class="page-title">Notes made to be <em>left on the bench.</em></h1>
    <p class="lede">Code, games, music, web experiments, friendship, and the ideas worth writing down before they wander off.</p>
  </header>

  <section class="page-section wrap" aria-labelledby="latest-note-heading">
    {posts.length === 0 ? (
      <div class="panel" style="padding: 2rem;"><p>No notes on the shelf yet.</p></div>
    ) : (
      <>
        <h2 id="latest-note-heading" class="sr-only">Latest note</h2>
        <div class="notes-layout">
          {featuredPost && (
            <a class="notes-feature panel-tactile" href={`${base}/blog/${featuredPost.id}`}>
              {featuredPost.data.image && (
                <Image
                  src={featuredPost.data.image}
                  alt={featuredPost.data.imageAlt ?? ""}
                  width={1200}
                  height={630}
                  loading="eager"
                  transition:name={`blog-image-${featuredPost.id}`}
                  transition:animate="initial"
                />
              )}
              <div class="notes-feature-copy">
                <div class="note-meta">
                  <time transition:name={`blog-date-${featuredPost.id}`} transition:animate="initial">{formatDate(featuredPost.data.date)}</time>
                  <span>@{featuredPost.data.author}</span>
                  <span>newest note</span>
                </div>
                <h2 transition:name={`blog-title-${featuredPost.id}`} transition:animate="initial">{featuredPost.data.title}</h2>
                <p transition:name={`blog-description-${featuredPost.id}`} transition:animate="initial">{featuredPost.data.description}</p>
                <span class="text-link" style="margin-top: 1.4rem;">Read this note <Icon name="lucide:arrow-right" width="15" height="15" /></span>
              </div>
            </a>
          )}

          <aside class="shelf-index panel" aria-label="Notes shelf index">
            <div class="shelf-index-header"><span>Shelf index</span><span>{posts.length} notes</span></div>
            <ul class="shelf-list">
              {posts.map((post) => (
                <li>
                  <a class="shelf-link" href={`${base}/blog/${post.id}`}>
                    <Icon name="lucide:file-text" width="16" height="16" />
                    <span>
                      <strong>{post.data.title}</strong>
                      <small>{formatDate(post.data.date)} · @{post.data.author}</small>
                    </span>
                    <Icon name="lucide:chevron-right" width="15" height="15" />
                  </a>
                </li>
              ))}
            </ul>
          </aside>
        </div>

        {archivePosts.length > 0 && (
          <section class="page-section" aria-labelledby="archive-heading">
            <div class="section-heading">
              <div>
                <p class="eyebrow">The archive</p>
                <h2 id="archive-heading" class="section-title">Signals that still <em>carry.</em></h2>
              </div>
            </div>
            <ul class="note-card-grid">
              {archivePosts.map((post) => (
                <li>
                  <a class="note-card" href={`${base}/blog/${post.id}`}>
                    <div class="note-meta"><time>{formatDate(post.data.date)}</time><span>@{post.data.author}</span></div>
                    <h3>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )}
      </>
    )}
  </section>
</Layout>
